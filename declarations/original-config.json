{
  "k": 3,
  "tfidf_threshold": 0.15,
  "keyword_threshold": 0.0,
  "passage_lines": 8,
  "ngram_range": [
    1,
    1
  ],
  "stop_words": "english",
  "strip_accents": "unicode",
  "token_pattern": "(?u)\\b\\w\\w+\\b",
  "norm": "l2",
  "smooth_idf": true,
  "seed": "None; deterministic fixture search",
  "corpus": "examples/corpus",
  "queries": "examples/queries.json"
}
